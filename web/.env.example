# Bond frontend — build-time configuration (copy to web/.env)
#
# Every VITE_* key is read at BUILD time and baked into the bundle.
# None of them are secrets: the frontend is public by definition.
# Restart `npm run dev` (or rebuild) after changing any value.

# ── Required ───────────────────────────────────────────────

# EscrowLink deployment address on Base Sepolia (chainId 84532).
# Without it the app renders the "not deployed here" state everywhere.
VITE_ESCROW_ADDRESS_BASE_SEPOLIA=0x0000000000000000000000000000000000000000

# Block number of the EscrowLink deployment transaction on Base Sepolia.
# Event scans start here. Leaving this empty or 0 makes "My records" scan
# from genesis, which public RPCs refuse (range too wide) — the view then
# looks silently empty. ALWAYS set this to the real deploy block.
VITE_ESCROW_DEPLOY_BLOCK=0

# ── Optional: Base mainnet (chainId 8453) ──────────────────
# Set both once the contract is deployed to mainnet; until then the UI
# reports "not deployed on this network" for Base mainnet wallets.
# VITE_ESCROW_ADDRESS_BASE=
# VITE_ESCROW_DEPLOY_BLOCK_BASE=

# ── Optional: RPC overrides ────────────────────────────────
# Defaults are public endpoints (publicnode) with automatic failover.
# The names below are read verbatim by src/lib/wagmi.ts.
# VITE_RPC_URL_MAINNET=
# VITE_RPC_URL_SEPOLIA=

# ── Optional: WalletConnect Cloud project id ───────────────
# https://cloud.walletconnect.com — enables the WalletConnect / QR
# connector. Without it only injected (MetaMask …) and Coinbase work.
# VITE_WALLETCONNECT_PROJECT_ID=
